<header class="site-header">
    <div class="nav-row">
        <a href="/ecommerce/home/index" class="brand">
            <span class="brand-name">DH <span>IMPORT</span></span>
        </a>

        <ul class="main-nav">
            <li class="has-dropdown">
                <button class="nav-link" aria-expanded="false" aria-haspopup="true">
                    Categorías
                </button>
                <div class="dropdown-panel">
                    {{#categorias}}
                        <a href="/ecommerce/producto/filtrarProduPorCategorias?id={{id}}">
                        <span class="cat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="8"/>
                            </svg>
                        </span>
                        {{nombre}}
                        </a>
                    {{/categorias}}

                    {{^categorias}}
                        <span class="dropdown-item-empty">No hay categorías disponibles</span>
                    {{/categorias}}
                </div>
            </li>
            <li><a href="/ecommerce/carrito/verCarrito?id={{cliente_id}}" class="nav-link">Ver carrito</a></li>
            <li><a href="/ecommerce/producto/ofertas" class="nav-link">Ofertas</a></li>
        </ul>

        <div class="user-actions">
            {{#logueado}}
                <!-- Se muestra si el usuario INICIÓ sesión -->
                <span class="user-welcome"><strong>{{nombre}} {{apellido}}</strong></span>
                <a href="?controller=usuario&method=cerrarSesion" class="btn-logout">
                    Cerrar sesión
                </a>
            {{/logueado}}

            {{^logueado}}
                <div class="nav-actions">
                    <a href="/ecommerce/usuario/iniciarSesion" class="btn btn-ghost">Ingresar</a>
                    <a href="/ecommerce/usuario/registro" class="btn btn-accent">Crear cuenta</a>
                </div>
            {{/logueado}}
        </div>
    </div>
</header>