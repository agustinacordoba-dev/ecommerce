<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DH Import - Ofertas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/ecommerce/public/css/style.css">
    <link rel="stylesheet" href="/ecommerce/public/css/login.css">
</head>
<body>
{{>header}}

<main class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h2>Iniciar Sesion</h2>
                <p>Ingresa tus datos para acceder a tu cuenta</p>
            </div>

            {{#mensaje}}
                <div class="alert-message">{{mensaje}}</div>
            {{/mensaje}}

            <form action="?controller=usuario&method=autenticarUsuario" method="POST">
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="ejemplo@email.com" required/>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required/>
                </div>

                <button type="submit" class="btn-primary">Iniciar Sesión</button>
            </form>

            <div class="auth-footer">
                <p>¿No tienes una cuenta? <a href="?controller=usuario&method=registro">Regístrate aquí</a></p>
            </div>
        </div>
    </div>
</main>

{{>footer}}
<script src="/ecommerce/public/js/menu.js"></script>
</body>
</html>